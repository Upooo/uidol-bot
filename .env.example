# ==============================
# Uidol Bot - Environment Config
# ==============================
# Copy to .env and fill values. NEVER commit real .env

# Telegram API (https://my.telegram.org)
API_ID=
API_HASH=

# Management Bot Token (@BotFather)
BOT_TOKEN=

# Owner Telegram user ID
OWNER_ID=

# Optional: comma-separated sudo user IDs
SUDO_USERS=

# Log group/channel ID (bot must be admin). Example: -100xxxxxxxxxx
LOG_GROUP_ID=

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB=uidol_bot

# Security — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Limits
MAX_USERBOTS=20
LOG_LEVEL=INFO

# Userbot command prefix
USERBOT_PREFIX=.

# Deploy OTP/2FA timeout (seconds)
DEPLOY_TIMEOUT=300

# Optional: auto-join these chats after deploy (comma-separated username or invite link)
FORCE_JOIN=
