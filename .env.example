# ==============================
# Uidol Bot - Environment Config
# ==============================
# Copy this file to .env and fill the values.
# NEVER commit your real .env file.

# Telegram API (get from https://my.telegram.org)
API_ID=
API_HASH=

# Management Bot Token (from @BotFather)
BOT_TOKEN=

# Owner
OWNER_ID=

# MongoDB
MONGO_URL=mongodb://localhost:27017
MONGO_DB=uidol_bot

# Security (generate a strong random key)
# Example: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional
MAX_USERBOTS=20
LOG_LEVEL=INFO
